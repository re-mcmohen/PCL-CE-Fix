+++ b/PCL.Core.Test/ReleaseUpdatePolicyTest.cs
@@ -0,0 +1,136 @@
+using System;
+using System.Text.Json.Nodes;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using PCL.Core.App;
+
+namespace PCL.Core.Test;
+
+[TestClass]
+public class ReleaseUpdatePolicyTest
+{
+    [TestMethod]
+    public void MicrosoftClientIdIsEmbeddedByConfiguredBuild()
+    {
+        var expected = Environment.GetEnvironmentVariable("PCL_EXPECTED_MS_CLIENT_ID");
+        if (string.IsNullOrWhiteSpace(expected))
+        {
+            Assert.Inconclusive("No Microsoft OAuth app configured for this build.");
+            return;
+        }
+        Assert.IsTrue(Guid.TryParse(expected, out _), "Configured OAuth app ID must be a GUID");
+        Assert.IsTrue(string.Equals(expected, PCL.Core.App.Secrets.MSOAuthClientId, StringComparison.Ordinal),
+            "Compiled Microsoft OAuth app ID must match the build configuration");
+        _ = new PCL.Core.Minecraft.Profile.Authentication.MicrosoftProvider();
+    }
+
+    [TestMethod]
+    public void StaleLatestResponseCannotDowngradeCurrentBuild()
+    {
+        var now = DateTimeOffset.UtcNow;
+        var release = new ReleaseUpdateCandidate(ReleaseUpdatePolicy.ForkRepository, "fix-older", new string('a', 40),
+            "", "", "", "", now.AddDays(-1));
+        Assert.IsFalse(release.IsNewer("2.15.1", "different", "fix-current", now));
+        Assert.IsTrue((release with { Tag = "fix-newer", PublishedAt = now.AddHours(1) })
+            .IsNewer("2.15.1", "different", "fix-current", now));
+    }
+
+    [TestMethod]
+    public void ReleaseIdentityIsEmbeddedByBuild()
+    {
+        var expected = Environment.GetEnvironmentVariable("PCL_EXPECTED_RELEASE_TAG");
+        if (string.IsNullOrEmpty(expected))
+        {
+            Assert.Inconclusive("Set PCL_EXPECTED_RELEASE_TAG and build with -p:PCLCEFixReleaseTag to verify CI metadata.");
+            return;
+        }
+        Assert.AreEqual(expected, ReleaseUpdatePolicy.CurrentReleaseTag);
+        Assert.IsNotNull(ReleaseUpdatePolicy.CurrentBuildTime);
+    }
+
+    private static JsonObject Release(string repo, string tag, bool arm64 = false)
+    {
+        var file = repo == ReleaseUpdatePolicy.ForkRepository
+            ? $"PCL_CE_Fix_{(arm64 ? "ARM64" : "x64")}.exe"
+            : $"PCL2_CE_Release_{(arm64 ? "ARM64" : "x64")}.exe";
+        return new JsonObject
+        {
+            ["draft"] = false, ["prerelease"] = false, ["tag_name"] = tag,
+            ["target_commitish"] = new string('a', 40), ["body"] = "notes",
+            ["assets"] = new JsonArray(new JsonObject
+            {
+                ["name"] = file, ["digest"] = "sha256:" + new string('b', 64),
+                ["browser_download_url"] = $"https://github.com/{repo}/releases/download/{tag}/{file}"
+            })
+        };
+    }
+
+    [TestMethod]
+    [DataRow(false)]
+    [DataRow(true)]
+    public void ForkChoosesExactArchitecture(bool arm64)
+    {
+        var release = ReleaseUpdatePolicy.Parse(Release(ReleaseUpdatePolicy.ForkRepository, "fix-one", arm64),
+            ReleaseUpdatePolicy.ForkRepository, arm64);
+        StringAssert.EndsWith(release.DownloadUrl, arm64 ? "_ARM64.exe" : "_x64.exe");
+        Assert.IsFalse(release.IsNewer("2.15.1", release.Commit));
+        Assert.IsTrue(release.IsNewer("2.15.1", new string('c', 40)));
+        Assert.IsFalse(release.IsNewer("2.15.1", "", "fix-one"));
+        Assert.IsTrue(release.IsNewer("2.15.1", release.Commit, "fix-older"));
+    }
+
+    [TestMethod]
+    public void ForkUpdateIsDetectedEvenWhenBaseVersionDoesNotChange()
+    {
+        var release = ReleaseUpdatePolicy.Parse(Release(ReleaseUpdatePolicy.ForkRepository, "fix-new"),
+            ReleaseUpdatePolicy.ForkRepository, false);
+        Assert.IsTrue(release.IsNewer("2.15.1", new string('c', 40)));
+    }
+
+    [TestMethod]
+    public void UpstreamUsesSemanticVersionInsteadOfDevBranchName()
+    {
+        var json = Release(ReleaseUpdatePolicy.UpstreamRepository, "v2.15.1");
+        json["target_commitish"] = "dev";
+        var release = ReleaseUpdatePolicy.Parse(json, ReleaseUpdatePolicy.UpstreamRepository, false);
+        Assert.IsTrue(release.IsNewer("2.15.0", ""));
+        Assert.IsFalse(release.IsNewer("2.15.1", ""));
+        Assert.IsFalse(release.IsNewer("2.16.0", ""));
+    }
+
+    [TestMethod]
+    public void MissingArchitectureIsRejected()
+    {
+        Assert.ThrowsExactly<FormatException>(() => ReleaseUpdatePolicy.Parse(
+            Release(ReleaseUpdatePolicy.ForkRepository, "fix-one"), ReleaseUpdatePolicy.ForkRepository, true));
+    }
+
+    [TestMethod]
+    [DataRow("")]
+    [DataRow("sha256:invalid")]
+    [DataRow("sha512:bbbb")]
+    public void MissingOrInvalidChecksumIsRejected(string digest)
+    {
+        var json = Release(ReleaseUpdatePolicy.ForkRepository, "fix-one");
+        json["assets"]![0]!["digest"] = digest;
+        Assert.ThrowsExactly<FormatException>(() => ReleaseUpdatePolicy.Parse(json, ReleaseUpdatePolicy.ForkRepository, false));
+    }
+
+    [TestMethod]
+    public void DownloadFromDifferentRepositoryIsRejected()
+    {
+        var json = Release(ReleaseUpdatePolicy.ForkRepository, "fix-one");
+        json["assets"]![0]!["browser_download_url"] = "https://github.com/other/repository/file.exe";
+        Assert.ThrowsExactly<FormatException>(() => ReleaseUpdatePolicy.Parse(json, ReleaseUpdatePolicy.ForkRepository, false));
+    }
+
+    [TestMethod]
+    public void DraftAndPrereleaseAreRejected()
+    {
+        var json = Release(ReleaseUpdatePolicy.ForkRepository, "fix-one");
+        json["draft"] = true;
+        Assert.ThrowsExactly<FormatException>(() => ReleaseUpdatePolicy.Parse(json, ReleaseUpdatePolicy.ForkRepository, false));
+        json["draft"] = false;
+        json["prerelease"] = true;
+        Assert.ThrowsExactly<FormatException>(() => ReleaseUpdatePolicy.Parse(json, ReleaseUpdatePolicy.ForkRepository, false));
+    }
+}
diff --git a/PCL.Core.Test/UpdateHelperTest.cs b/PCL.Core.Test/UpdateHelperTest.cs
new file mode 100644
index 00000000..71192da6
--- /dev/null
+++ b/PCL.Core.Test/UpdateHelperTest.cs
@@ -0,0 +1,122 @@
+using System;
+using System.IO;
+using System.Threading.Tasks;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using PCL.Core.App.Essentials;
+
+namespace PCL.Core.Test;
+
+[TestClass]
+public class UpdateHelperTest
+{
+    private string _directory = null!;
+    private string Source => Path.Combine(_directory, "new.exe");
+    private string Target => Path.Combine(_directory, "launcher.exe");
+
+    [TestInitialize]
+    public void Initialize()
+    {
+        _directory = Path.Combine(Path.GetTempPath(), "pcl-update-test-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_directory);
+        File.WriteAllText(Source, "new executable");
+        File.WriteAllText(Target, "old executable");
+    }
+
+    [TestCleanup]
+    public void Cleanup() => Directory.Delete(_directory, recursive: true);
+
+    [TestMethod]
+    public void CleanupRetriesLockedSuccessfulBackupAndPreservesFailedBackup()
+    {
+        var stem = Target + ".update." + Guid.NewGuid().ToString("N");
+        var failed = Target + ".update." + Guid.NewGuid().ToString("N") + ".bak";
+        File.WriteAllText(failed, "recovery");
+        File.WriteAllText(stem + ".bak", "completed backup");
+        File.WriteAllText(stem + ".done", UpdateHelper.ComputeSha256(Target));
+        using (var locked = new FileStream(stem + ".bak", FileMode.Open, FileAccess.Read, FileShare.None))
+        {
+            UpdateHelper.CleanupCompletedUpdates(Target);
+            Assert.IsTrue(File.Exists(stem + ".done"));
+        }
+        UpdateHelper.CleanupCompletedUpdates(Target);
+        Assert.IsFalse(File.Exists(stem + ".bak"));
+        Assert.IsFalse(File.Exists(stem + ".done"));
+        Assert.AreEqual("recovery", File.ReadAllText(failed));
+    }
+
+    [TestMethod]
+    public void CleanupOnlyRemovesStaleTemporaryFilesOwnedByThisExecutable()
+    {
+        var stale = Target + ".update." + Guid.NewGuid().ToString("N") + ".tmp";
+        var fresh = Target + ".update." + Guid.NewGuid().ToString("N") + ".tmp";
+        var unrelated = Target + ".update.notes.tmp";
+        File.WriteAllText(stale, "stale"); File.SetLastWriteTimeUtc(stale, DateTime.UtcNow.AddDays(-2));
+        File.WriteAllText(fresh, "active"); File.WriteAllText(unrelated, "user file");
+        UpdateHelper.CleanupCompletedUpdates(Target);
+        Assert.IsFalse(File.Exists(stale));
+        Assert.IsTrue(File.Exists(fresh));
+        Assert.IsTrue(File.Exists(unrelated));
+    }
+
+    [TestMethod]
+    public void ReplacesExistingExecutableAndVerifiesInstalledHash()
+    {
+        Assert.IsNull(UpdateHelper.Replace(Source, Target, UpdateHelper.ComputeSha256(Source)));
+        Assert.AreEqual("new executable", File.ReadAllText(Target));
+        Assert.AreEqual(2, Directory.GetFiles(_directory).Length);
+    }
+
+    [TestMethod]
+    public void InstallsWhenTargetIsMissing()
+    {
+        File.Delete(Target);
+        Assert.IsNull(UpdateHelper.Replace(Source, Target));
+        Assert.AreEqual("new executable", File.ReadAllText(Target));
+    }
+
+    [TestMethod]
+    public void WrongHashPreservesOldExecutable()
+    {
+        Assert.IsInstanceOfType<InvalidDataException>(UpdateHelper.Replace(Source, Target, new string('0', 64)));
+        Assert.AreEqual("old executable", File.ReadAllText(Target));
+    }
+
+    [TestMethod]
+    public void MissingSourcePreservesOldExecutable()
+    {
+        File.Delete(Source);
+        Assert.IsNotNull(UpdateHelper.Replace(Source, Target));
+        Assert.AreEqual("old executable", File.ReadAllText(Target));
+    }
+
+    [TestMethod]
+    public void RejectsReplacingSourceWithItself()
+    {
+        Assert.IsInstanceOfType<ArgumentException>(UpdateHelper.Replace(Source, Source));
+        Assert.AreEqual("new executable", File.ReadAllText(Source));
+    }
+
+    [TestMethod]
+    public async Task TemporaryWindowsLockRetriesUntilReplacementSucceeds()
+    {
+        var locked = new FileStream(Target, FileMode.Open, FileAccess.Read, FileShare.None);
+        var replace = Task.Run(() => UpdateHelper.Replace(Source, Target, retryTimeout: TimeSpan.FromSeconds(5)));
+        try
+        {
+            await Task.Delay(450);
+            Assert.IsFalse(replace.IsCompleted, "Replacement must wait while the target is locked");
+        }
+        finally { locked.Dispose(); }
+        Assert.IsNull(await replace);
+        Assert.AreEqual("new executable", File.ReadAllText(Target));
+    }
+
+    [TestMethod]
+    public void PersistentLockFailsWithoutDeletingOldExecutable()
+    {
+        using (var locked = new FileStream(Target, FileMode.Open, FileAccess.Read, FileShare.None))
+            Assert.IsNotNull(UpdateHelper.Replace(Source, Target, retryTimeout: TimeSpan.FromMilliseconds(200)));
+        Assert.AreEqual("old executable", File.ReadAllText(Target));
+        Assert.AreEqual(2, Directory.GetFiles(_directory).Length);
+    }
+}
