diff --git a/PCL.Core/App/Essentials/UpdateHelper.cs b/PCL.Core/App/Essentials/UpdateHelper.cs
index 3969cf90..861df6ca 100644
--- a/PCL.Core/App/Essentials/UpdateHelper.cs
